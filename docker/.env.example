# -----------------------------------------------------------------------------
# Example environment variables for a self-hosted Medusa app.
# In Coolify, set these in the application's "Environment Variables" tab
# (mark JWT_SECRET / COOKIE_SECRET as secrets). Do NOT commit a real .env.
# -----------------------------------------------------------------------------

NODE_ENV=production
# Port Medusa listens on inside the container (Coolify maps this).
PORT=9000

# --- Database (Coolify-managed Postgres) ------------------------------------
# Use the internal connection string from your Coolify Postgres resource.
DATABASE_URL=postgres://medusa:medusa@postgres:5432/medusa

# --- Redis (Coolify-managed Redis) ------------------------------------------
# Used for the event bus, workflow engine and cache modules in production.
REDIS_URL=redis://redis:6379

# --- Secrets — generate strong random values (e.g. `openssl rand -hex 32`) --
JWT_SECRET=change-me
COOKIE_SECRET=change-me

# --- CORS — comma-separated origins -----------------------------------------
STORE_CORS=https://your-storefront.example.com
ADMIN_CORS=https://admin.your-domain.example.com
AUTH_CORS=https://admin.your-domain.example.com,https://your-storefront.example.com

# --- Optional: run migrations / seed on container start ---------------------
# Migrations run by default; set to false to manage them separately.
MEDUSA_RUN_MIGRATIONS=true
MEDUSA_RUN_SEED=false

# --- Admin dashboard ---------------------------------------------------------
# The admin is built into the image and served at /app by default.
# If you serve it from a different host, set MEDUSA_ADMIN_BACKEND_URL at build
# time to your public backend URL.
# MEDUSA_ADMIN_BACKEND_URL=https://admin.your-domain.example.com
