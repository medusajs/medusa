# Copy to `.env` for local runs. In Coolify set these as env vars / secrets.
NODE_ENV=production
PORT=9000

# Provided automatically by the root docker-compose.yml. Override for managed DBs.
DATABASE_URL=postgres://medusa:medusa@postgres:5432/medusa
REDIS_URL=redis://redis:6379

# Generate strong values: `openssl rand -hex 32`
JWT_SECRET=change-me
COOKIE_SECRET=change-me

# CORS — comma-separated origins (scheme + host + port must match exactly)
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:8000

# Optional: auto-create an admin user on first boot
# MEDUSA_ADMIN_EMAIL=admin@example.com
# MEDUSA_ADMIN_PASSWORD=supersecret

# Optional toggles
MEDUSA_RUN_MIGRATIONS=true
MEDUSA_RUN_SEED=false
