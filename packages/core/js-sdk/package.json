{
  "name": "@medusajs/js-sdk",
  "version": "2.22.1",
  "description": "SDK for the Medusa API",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "import": "./dist/esm/index.js",
    "require": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medusajs/medusa.git",
    "directory": "packages/core/js-sdk"
  },
  "bugs": {
    "url": "https://github.com/medusajs/medusa/issues"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "AGENTS.md",
    "!dist/**/__tests__",
    "!dist/**/__mocks__",
    "!dist/**/__fixtures__"
  ],
  "llms": "https://docs.medusajs.com/llms.txt",
  "llmsFull": "https://docs.medusajs.com/llms-full.txt",
  "mcpServer": "https://docs.medusajs.com/mcp",
  "author": "Medusa",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@medusajs/types": "2.22.1"
  },
  "dependencies": {
    "fetch-event-stream": "^0.1.5",
    "qs": "^6.16.1"
  },
  "scripts": {
    "build": "yarn run -T rimraf dist && yarn run -T tsc -p tsconfig.json && yarn run -T tsc -p tsconfig.esm.json",
    "test": "../../../node_modules/.bin/jest --passWithNoTests --bail --forceExit --detectOpenHandles",
    "watch": "yarn run -T tsc --build --watch"
  }
}
