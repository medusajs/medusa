{
  "name": "@medusajs/search-local",
  "version": "2.19.0",
  "description": "Local search provider for Medusa, backed by Orama",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medusajs/medusa.git",
    "directory": "packages/modules/providers/search-local"
  },
  "bugs": {
    "url": "https://github.com/medusajs/medusa/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/__mocks__",
    "!dist/**/__fixtures__"
  ],
  "engines": {
    "node": ">=20"
  },
  "author": "Medusa",
  "license": "MIT",
  "scripts": {
    "test": "../../../../node_modules/.bin/jest --passWithNoTests src",
    "build": "yarn run -T rimraf dist && yarn run -T tsc --build ./tsconfig.json",
    "watch": "yarn run -T tsc --watch"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18"
  },
  "devDependencies": {
    "@medusajs/framework": "2.19.0",
    "@medusajs/test-utils": "2.19.0"
  },
  "peerDependencies": {
    "@medusajs/framework": "2.19.0"
  },
  "keywords": [
    "medusa-plugin",
    "medusa-plugin-search"
  ]
}
