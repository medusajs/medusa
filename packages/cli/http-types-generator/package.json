{
  "name": "@medusajs/http-types-generator",
  "version": "2.22.2",
  "description": "Generate and validate HTTP TypeScript types",
  "main": "dist/index.js",
  "bin": {
    "medusa-http-types": "dist/index.js"
  },
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "llms": "https://docs.medusajs.com/llms.txt",
  "llmsFull": "https://docs.medusajs.com/llms-full.txt",
  "mcpServer": "https://docs.medusajs.com/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medusajs/medusa.git",
    "directory": "packages/cli/http-types-generator"
  },
  "bugs": {
    "url": "https://github.com/medusajs/medusa/issues"
  },
  "publishConfig": {
