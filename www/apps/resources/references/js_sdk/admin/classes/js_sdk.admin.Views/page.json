{"slug":"/references/js_sdk/admin/classes/js_sdk.admin.Views","title":"Views","frontmatter":{},"toc":[{"title":"Methods","id":"methods","level":2},{"title":"Properties","id":"properties","level":2}],"blocks":[{"kind":"markdown","html":"This class is used to send requests to the view configuration admin API routes.\nIt can be accessed via `sdk.admin.views`.\n\nView configurations store the column visibility, ordering, filters, and sorting\npreferences for an entity's data table in the admin dashboard."},{"kind":"heading","level":2,"text":"Methods","id":"methods"},{"kind":"linkList","items":[{"title":"columns","href":"/references/js_sdk/admin/Views/methods/js_sdk.admin.Views.columns"},{"title":"createConfiguration","href":"/references/js_sdk/admin/Views/methods/js_sdk.admin.Views.createConfiguration"},{"title":"deleteConfiguration","href":"/references/js_sdk/admin/Views/methods/js_sdk.admin.Views.deleteConfiguration"},{"title":"listConfigurations","href":"/references/js_sdk/admin/Views/methods/js_sdk.admin.Views.listConfigurations"},{"title":"listEntities","href":"/references/js_sdk/admin/Views/methods/js_sdk.admin.Views.listEntities"},{"title":"retrieveActiveConfiguration","href":"/references/js_sdk/admin/Views/methods/js_sdk.admin.Views.retrieveActiveConfiguration"},{"title":"retrieveConfiguration","href":"/references/js_sdk/admin/Views/methods/js_sdk.admin.Views.retrieveConfiguration"},{"title":"setActiveConfiguration","href":"/references/js_sdk/admin/Views/methods/js_sdk.admin.Views.setActiveConfiguration"},{"title":"updateConfiguration","href":"/references/js_sdk/admin/Views/methods/js_sdk.admin.Views.updateConfiguration"}]},{"kind":"heading","level":2,"text":"Properties","id":"properties"},{"kind":"linkList","items":[{"title":"client","href":"/references/js_sdk/admin/Views/properties/js_sdk.admin.Views.client"}]}]}