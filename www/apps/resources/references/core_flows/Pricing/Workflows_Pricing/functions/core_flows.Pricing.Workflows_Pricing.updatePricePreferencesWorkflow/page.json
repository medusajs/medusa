s_tax_inclusive: true\n        }\n      }\n    })\n\n  res.send(result)\n}"},{"label":"Subscriber","language":"ts","title":"src/subscribers/order-placed.ts","code":"import {\n  type SubscriberConfig,\n  type SubscriberArgs,\n} from \"@medusajs/framework\"\nimport { updatePricePreferencesWorkflow } from \"@medusajs/medusa/core-flows\"\n\nexport default async function handleOrderPlaced({\n  event: { data },\n  container,\n}: SubscriberArgs < { id: string } > ) {\n  const { result } = await updatePricePreferencesWorkflow(container)\n    .run({\n      input: {\n        selector: {\n          id: [\"pp_123\"]\n        },\n        update: {\n          is_tax_inclusive: true\n        }\n      }\n    })\n\n  console.log(result)\n}\n\nexport const config: SubscriberConfig = {\n  event: \"order.placed\",\n}"},{"label":"Scheduled Job","language":"ts","title":"src/jobs/message-daily.ts","code":"import { MedusaContainer } from \"@medusajs/framework/types\"\nimport { updatePricePreferencesWorkflow } from \"@medusajs/medusa/core-flows\"\n\nexport default async function myCustomJob(\n  container: MedusaContainer\n) {\n  const { result } = await updatePricePreferencesWorkflow(container)\n    .run({\n      input: {\n        selector: {\n          id: [\"pp_123\"]\n        },\n        update: {\n          is_tax_inclusive: true\n        }\n      }\n    })\n\n  console.log(result)\n}\n\nexport const config = {\n  name: \"run-once-a-day\",\n  schedule: \"0 0 * * *\",\n}"},{"label":"Another Workflow","language":"ts","title":"src/workflows/my-workflow.ts","code":"import { createWorkflow } from \"@medusajs/framework/workflows-sdk\"\nimport { updatePricePreferencesWorkflow } from \"@medusajs/medusa/core-flows\"\n\nconst myWorkflow = createWorkflow(\n  \"my-workflow\",\n  () => {\n    const result = updatePricePreferencesWorkflow\n      .runAsStep({\n        input: {\n          selector: {\n            id: [\"pp_123\"]\n          },\n          update: {\n            is_tax_inclusive: true\n 