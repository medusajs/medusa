{"slug":"/references/types/SearchTypes/interfaces/types.SearchTypes.ProviderSearchQuery","title":"ProviderSearchQuery","frontmatter":{},"toc":[{"title":"Properties","id":"properties","level":2}],"blocks":[{"kind":"markdown","html":"The caller's query plus the resolved definition. `attributes_to_retrieve` is\nalready narrowed to what the index can serve, so project it as given."},{"kind":"heading","level":2,"text":"Properties","id":"properties"},{"kind":"typeList","sectionTitle":"ProviderSearchQuery","types":[{"name":"index","type":"[ResolvedSearchIndexDefinition](/references/types/SearchTypes/interfaces/types.SearchTypes.ResolvedSearchIndexDefinition)","description":"","optional":false,"defaultValue":"","expandable":false,"children":[{"name":"name","type":"`string`","description":"","optional":false,"defaultValue":"","expandable":false,"children":[]},{"name":"entity","type":"`string`","description":"","optional":false,"defaultValue":"","expandable":false,"children":[]},{"name":"fields","type":"`Record<string, [SearchFieldDefinition](/references/types/SearchTypes/interfaces/types.SearchTypes.SearchFieldDefinition)>`","description":"","optional":false,"defaultValue":"","expandable":false,"children":[{"name":"type","type":"[SearchFieldKind](/references/types/SearchTypes/types/types.SearchTypes.SearchFieldKind)","description":"","optional":false,"defaultValue":"","expandable":false,"children":[]},{"name":"array","type":"`boolean`","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"searchable","type":"`boolean` \\| `object`","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"filterable","type":"`boolean`","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"sortable","type":"`boolean`","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"facetable","type":"`boolean` \\| `object`","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"retrievable","type":"`boolean`","description":"Whether the field comes back on hits. `false` for index-only fields, such as a\nblob used purely for matching. `query.search` reads this to decide which\nrequested fields the engine can serve and which need `query.graph`.","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"fields","type":"`Record<string, [SearchFieldDefinition](/references/types/SearchTypes/interfaces/types.SearchTypes.SearchFieldDefinition)>`","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"correlated","type":"`boolean`","description":"Only meaningful on an array of objects. When `true`, filters on the object's\nsub-fields must all match within a *single* element — `variants.color = \"red\"\nAND variants.size = \"XL\"` matches a product with a red XL variant, not one\nwith a red S and a blue XL. Off by default because most engines flatten\narrays and cannot express it; a provider that cannot rejects it from\n`upsertIndex`, so this fails at boot rather than over-matching later.","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"dimensions","type":"`number`","description":"The dimensionality of the embedding stored in a `type: \"vector\"` field —\nevery vector written to it must have exactly this many components. Required\nfor vector fields; meaningless on any other type.","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"provider_options","type":"`Record<string, Record&#60;string, unknown&#62;>`","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]}]},{"name":"events","type":"`string`[]","description":"Events related and that can affect the data for this index.","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"consume","type":"(`event`: [Event](/references/types/EventBusTypes/types/types.EventBusTypes.Event)&#60;any&#62;, `context`: [SearchIngestionContext](/references/types/SearchTypes/interfaces/types.SearchTypes.SearchIngestionContext)) => Promise&#60;[SearchMutation](/references/types/SearchTypes/types/types.SearchTypes.SearchMutation)[]&#62;","description":"Executed on event ingestion to determine the action that needs to be performed on the index.","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"seed","type":"(`context`: [SearchSeedContext](/references/types/SearchTypes/interfaces/types.SearchTypes.SearchSeedContext)) => AsyncIterable&#60;[SearchDocument](/references/types/SearchTypes/types/types.SearchTypes.SearchDocument)[]&#62;","description":"","optional":false,"defaultValue":"","expandable":false,"children":[]},{"name":"primary_key","type":"`string`","description":"","optional":false,"defaultValue":"","expandable":false,"children":[]},{"name":"provider","type":"`string`","description":"","optional":false,"defaultValue":"","expandable":false,"children":[]},{"name":"settings","type":"[SearchIndexSettings](/references/types/SearchTypes/interfaces/types.SearchTypes.SearchIndexSettings)","description":"","optional":false,"defaultValue":"","expandable":false,"children":[{"name":"synonyms","type":"`Record<string, string[]>`","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"stop_words","type":"`string`[]","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"typo_tolerance","type":"`object`","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"faceting","type":"`object`","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"pagination","type":"`object`","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"distinct_attribute","type":"`string`","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"locales","type":"`string`[]","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"provider_options","type":"`Record<string, Record&#60;string, unknown&#62;>`","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]}]},{"name":"definition_hash","type":"`string`","description":"","optional":false,"defaultValue":"","expandable":false,"children":[]},{"name":"physical_name","type":"`string`","description":"","optional":false,"defaultValue":"","expandable":false,"children":[]}]},{"name":"attributes_to_retrieve","type":"`string`[]","description":"","optional":false,"defaultValue":"","expandable":false,"children":[]},{"name":"q","type":"`string`","description":"Lifted out of `filters` by the module, because `filters` compiles to a DSL\nwith no representation for free text.","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"filters","type":"[SearchFilters](/references/types/SearchTypes/types/types.SearchTypes.SearchFilters)","description":"","optional":true,"defaultValue":"","expandable":false,"children":[{"name":"$and","type":"[SearchFilters](/references/types/SearchTypes/types/types.SearchTypes.SearchFilters)[]","description":"","optional":true,"defaultValue":"","expandable":false,"children":[{"name":"$and","type":"[SearchFilters](/references/types/SearchTypes/types/types.SearchTypes.SearchFilters)[]","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"$or","type":"[SearchFilters](/references/types/SearchTypes/types/types.SearchTypes.SearchFilters)[]","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"$not","type":"[SearchFilters](/references/types/SearchTypes/types/types.SearchTypes.SearchFilters)","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"q","type":"`string`","description":"The free-text query. Sits among the filters so a `query.graph` call converts\nto `query.search` unchanged; the module lifts it out before compiling the\nrest, so a provider never sees `q` as a field.","optional":true,"defaultValue":"","expandable":false,"children":[]}]},{"name":"$or","type":"[SearchFilters](/references/types/SearchTypes/types/types.SearchTypes.SearchFilters)[]","description":"","optional":true,"defaultValue":"","expandable":false,"children":[{"name":"$and","type":"[SearchFilters](/references/types/SearchTypes/types/types.SearchTypes.SearchFilters)[]","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"$or","type":"[SearchFilters](/references/types/SearchTypes/types/types.SearchTypes.SearchFilters)[]","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"$not","type":"[SearchFilters](/references/types/SearchTypes/types/types.SearchTypes.SearchFilters)","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"q","type":"`string`","description":"The free-text query. Sits among the filters so a `query.graph` call converts\nto `query.search` unchanged; the module lifts it out before compiling the\nrest, so a provider never sees `q` as a field.","optional":true,"defaultValue":"","expandable":false,"children":[]}]},{"name":"$not","type":"[SearchFilters](/references/types/SearchTypes/types/types.SearchTypes.SearchFilters)","description":"","optional":true,"defaultValue":"","expandable":false,"children":[{"name":"$and","type":"[SearchFilters](/references/types/SearchTypes/types/types.SearchTypes.SearchFilters)[]","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"$or","type":"[SearchFilters](/references/types/SearchTypes/types/types.SearchTypes.SearchFilters)[]","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"$not","type":"[SearchFilters](/references/types/SearchTypes/types/types.SearchTypes.SearchFilters)","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"q","type":"`string`","description":"The free-text query. Sits among the filters so a `query.graph` call converts\nto `query.search` unchanged; the module lifts it out before compiling the\nrest, so a provider never sees `q` as a field.","optional":true,"defaultValue":"","expandable":false,"children":[]}]},{"name":"q","type":"`string`","description":"The free-text query. Sits among the filters so a `query.graph` call converts\nto `query.search` unchanged; the module lifts it out before compiling the\nrest, so a provider never sees `q` as a field.","optional":true,"defaultValue":"","expandable":false,"children":[]}]},{"name":"pagination","type":"[SearchPagination](/references/types/SearchTypes/interfaces/types.SearchTypes.SearchPagination)","description":"","optional":true,"defaultValue":"","expandable":false,"children":[{"name":"skip","type":"`number`","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"take","type":"`number`","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"order","type":"`Record<string, [SearchOrderBy](/references/types/SearchTypes/types/types.SearchTypes.SearchOrderBy)>`","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"cursor","type":"`string`","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]}]},{"name":"search_options","type":"[SearchOptions](/references/types/SearchTypes/interfaces/types.SearchTypes.SearchOptions)","description":"","optional":true,"defaultValue":"","expandable":false,"children":[{"name":"attributes_to_search_on","type":"`string`[]","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"match_strategy","type":"[SearchMatchStrategy](/references/types/SearchTypes/types/types.SearchTypes.SearchMatchStrategy)","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"typo_tolerance","type":"`boolean`","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"facets","type":"(`string` \\| [SearchFacetRequest](/references/types/SearchTypes/types/types.SearchTypes.SearchFacetRequest))[]","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"disjunctive_facets","type":"`boolean`","description":"Compute each facet ignoring the filter on that same field, so a storefront\nkeeps showing sibling values of an active filter. Needs one query per facet\non every engine reviewed, so the module fans out over `searchMany`.","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"highlight","type":"[SearchHighlightOptions](/references/types/SearchTypes/interfaces/types.SearchTypes.SearchHighlightOptions)","description":"","optional":true,"defaultValue":"","expandable":false,"children":[{"name":"fields","type":"`string`[]","description":"","optional":false,"defaultValue":"","expandable":false,"children":[]},{"name":"pre_tag","type":"`string`","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"post_tag","type":"`string`","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"snippet","type":"`boolean` \\| `object`","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]}]},{"name":"distinct","type":"`string`","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"min_score","type":"`number`","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"include_score","type":"`boolean`","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"locales","type":"`string`[]","description":"Query-time language hint, e.g. `[\"en\"]`. Engines that analyze per language\n(Meilisearch, Algolia) use it to pick the analyzer; a provider that cannot\nhonour it rejects it rather than silently matching differently. Defaults to\nthe index' `settings.locales`.","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"vector","type":"[SearchVectorOptions](/references/types/SearchTypes/interfaces/types.SearchTypes.SearchVectorOptions)","description":"","optional":true,"defaultValue":"","expandable":false,"children":[{"name":"field","type":"`string`","description":"","optional":false,"defaultValue":"","expandable":false,"children":[]},{"name":"value","type":"`number`[]","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"query","type":"`string`","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"semantic_ratio","type":"`number`","description":"","optional":true,"defaultValue":"","expandable":false,"children":[]}]},{"name":"count","type":"[SearchCountStrategy](/references/types/SearchTypes/types/types.SearchTypes.SearchCountStrategy)","description":"`\"exact\"` may be rejected or slow depending on the provider.","optional":true,"defaultValue":"","expandable":false,"children":[]},{"name":"provider_options","type":"`Record<string, Record&#60;string, unknown&#62;>`","description":"Escape hatch for engine features the interface does not model, keyed by\nprovider identifier, e.g. `{ typesense: { drop_tokens_threshold: 0 } }`.","optional":true,"defaultValue":"","expandable":false,"children":[]}]}]}]}