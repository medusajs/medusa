{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "lint": { },
    "watch": { },
    "generate:references": {
      "dependsOn": [
        "^build"
      ]
    },
    "generate:oas": {
      "dependsOn": [
        "^build"
      ]
    },
    "generate:dml": {
      "dependsOn": [
        "^build"
      ]
    }
  }
}