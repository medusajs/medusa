{
  "name": "persona-journeys",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "yarn clean && yarn run -T tsc",
    "clean": "rimraf dist",
    "watch": "yarn run -T tsc --watch",
    "journeys": "node dist/cli.js",
    "proxy": "node dist/proxy.js",
    "view": "promptfoo view",
    "lint": "yarn run -T eslint --ext .ts src"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.328",
    "@playwright/mcp": "0.0.86",
    "afdocs": "0.23.0",
    "promptfoo": "0.126.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.10",
    "rimraf": "^5.0.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
