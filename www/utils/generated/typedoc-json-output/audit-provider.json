							"comment": {
								"summary": [
									{
										"kind": "text",
										"text": "This method stores a batch of audit logs. The Audit Module calls it with\nbuffered audit logs that already have their ID and dates set.\n\nThrow when the batch can't be stored. The module retries a few times before\nit drops the batch, so the write should be safe to repeat."
									}
								],
								"blockTags": [
									{
										"tag": "@returns",
										"content": [
											{
												"kind": "text",
												"text": "Resolves when the batch is stored."
											}
										]
									},
									{
										"tag": "@example",
										"content": [
											{
												"kind": "code",
												"text": "```ts\nclass MyAuditProviderService extends AbstractAuditProviderService {\n  // ...\n  async write(entries: AuditLogDTO[]): Promise<void> {\n    await this.client.insert(entries)\n  }\n}\n```"
											}
										]
									}
								]
							},
